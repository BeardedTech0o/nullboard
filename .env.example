# Copy to .env. Never commit it. Generate secrets with: openssl rand -hex 32
SITE_HOST=board.lan
SITE_URL=https://board.lan
JWT_SECRET=
DATA_KEY=
ALLOWED_EMAILS=you@example.com
# Password reset: either set a Resend key, or print links to the container log.
RESEND_API_KEY=
EMAIL_FROM=nullboard <onboarding@resend.dev>
LOG_RESET_LINKS=1
