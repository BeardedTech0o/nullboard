# Local HTTPS with no public domain: Caddy signs the certificate with its own
# internal CA. Install that CA on your devices once (see README).
{$SITE_HOST} {
	tls internal
	encode gzip
	reverse_proxy app:8787 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}
